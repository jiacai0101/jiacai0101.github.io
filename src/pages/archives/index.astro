---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/content/ArchiveList.astro";
import { useTranslations } from "../../i18n/ui";
const t = useTranslations("en");
---

<BaseLayout title={t("page.archives.title")}>
    <div class="container-narrow">
        <header class="page-header">
            <h1 class="page-title">{t("page.archives.title")}</h1>
            <p class="page-subtitle">{t("page.archives.subtitle")}</p>
        </header>
        <ArchiveList locale="en" />
    </div>
</BaseLayout>

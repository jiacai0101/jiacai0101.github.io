---
import { getCollection } from "astro:content";
import BaseDetail from "../../../layouts/BaseDetail.astro";
import { stripLocaleId } from "../../../i18n/ui";

export async function getStaticPaths() {
    const entries = (await getCollection("projects")).filter((e: any) => e.id.startsWith("zh/"));
    return entries.map((e: any) => ({
        params: { id: stripLocaleId(e.id) },
        props: { fullId: e.id },
    }));
}

const { fullId } = Astro.props;
---

<BaseDetail collection="projects" id={fullId} locale="zh" />

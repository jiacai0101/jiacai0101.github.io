---
import { getCollection } from "astro:content";
import BaseDetail from "../../../layouts/BaseDetail.astro";
import ShareButtons from "../../../components/ui/ShareButtons.astro";
import { stripLocaleId } from "../../../i18n/ui";
import { SITE } from "../../../config";

export async function getStaticPaths() {
    const posts = (await getCollection("posts")).filter((p: any) => p.id.startsWith("zh/"));
    return posts.map((post: any) => ({
        params: { id: stripLocaleId(post.id) },
        props: { post },
    }));
}

const { post } = Astro.props;
const postUrl = new URL(`/zh/posts/${stripLocaleId(post.id)}`, SITE.website).href;
---

<BaseDetail collection="posts" id={post.id} locale="zh">
    <div slot="share" class="container-narrow">
        <ShareButtons title={post.data.title} url={postUrl} description={post.data.description} />
    </div>
</BaseDetail>

---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsList from "../../components/content/NewsList.astro";
import HomeSections from "../../components/content/HomeSections.astro";
import { useTranslations } from "../../i18n/ui";

const t = useTranslations("zh");
const bioEntry = await getEntry("bio", "bio-zh");
const { Content: BioContent } = bioEntry ? await render(bioEntry) : { Content: null };
---

<BaseLayout title={t("page.home.title")}>
    <div class="container-narrow">
        <header class="page-header">
            <h1 class="page-title">{t("page.home.title")}</h1>
        </header>
        <div class="prose">
            {BioContent ? <BioContent /> : <p>Loading…</p>}
        </div>

        <section class="news-section">
            <h2 class="section-heading title-lg">{t("news.title")}</h2>
            <NewsList limit={6} />
        </section>

        <HomeSections locale="zh" />
    </div>
</BaseLayout>

---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Timeline from "../../../components/ui/Timeline.astro";
import { useTranslations } from "../../../i18n/ui";

const t = useTranslations("zh");
const cvEntry = await getEntry("cv", "cv-zh");
if (!cvEntry) {
    throw new Error("CV content not found. Ensure src/content/cv-zh.md exists.");
}
const { Content } = await render(cvEntry);
const { experience = [], education = [] } = cvEntry.data;
---

<BaseLayout title={t("page.cv.title")}>
    <header class="page-header">
        <h1 class="page-title">{t("page.cv.title")}</h1>
        <p class="page-subtitle">{t("page.cv.subtitle")}</p>
    </header>

    <div class="container-narrow">
        {
            experience.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">工作经历</h2>
                    <Timeline items={experience.map((exp) => ({
                        title: exp.role,
                        subtitle: exp.institution,
                        period: exp.period,
                        description: exp.description,
                    }))} />
                </section>
            )
        }

        {
            education.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">教育经历</h2>
                    <Timeline items={education.map((edu) => ({
                        title: edu.degree,
                        subtitle: edu.institution,
                        period: edu.period,
                        description: edu.description,
                        thesis: edu.thesis,
                    }))} />
                </section>
            )
        }

        <div class="prose max-w-none">
            <Content />
        </div>
    </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsList from "../components/content/NewsList.astro";
import HomeSections from "../components/content/HomeSections.astro";
import BibliographyList from "../components/content/BibliographyList.astro";
import { getProfile } from "../data/profile";
import { getCollection, getEntry, render } from "astro:content";
import { useTranslations } from "../i18n/ui";

const locale = "en";
const t = useTranslations(locale);
const profile = getProfile(locale);
const bioEntry = await getEntry("bio", "bio");
const { Content: BioContent } = bioEntry
    ? await render(bioEntry)
    : { Content: undefined };
const selected = (await getCollection("publications"))
    .filter((entry) => !entry.id.startsWith("zh/") && entry.data.selected)
    .sort((a, b) => {
        const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
        const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
        return dateB - dateA;
    });
---

<BaseLayout title={profile.name}>
    <div class="home">
        <header class="home-hero">
            <h1 class="home-identity">{profile.statement}</h1>
            {BioContent && (
                <div class="home-bio">
                    <BioContent />
                </div>
            )}
            <p class="home-proof">{profile.proof}</p>
        </header>

        {selected.length > 0 && (
            <section class="home-section">
                <div class="section-heading-row">
                    <h2 class="section-heading">{t("home.selected")}</h2>
                    <a class="section-more" href="/publications">{t("home.all")}</a>
                </div>
                <BibliographyList entries={selected} locale={locale} />
            </section>
        )}

        <section class="home-section">
            <h2 class="section-heading">{t("news.title")}</h2>
            <NewsList limit={6} />
        </section>

        <HomeSections locale={locale} />
    </div>
</BaseLayout>

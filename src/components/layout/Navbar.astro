---
import { NAV_LINKS, PAGES } from "../../config";
import Icon from "../ui/Icon.astro";
import { useTranslations } from "../../i18n/ui";

const t = useTranslations("en");
const currentPath = Astro.url.pathname;

const KEY: Record<string, string> = {
    "/": "about",
    "/publications": "publications",
    "/talks": "talks",
    "/projects": "projects",
    "/posts": "blog",
    "/tags": "tags",
    "/cv": "cv",
    "/search": "search",
};

const links = NAV_LINKS.filter((link) => {
    // Search is rendered as an icon button, not a text link.
    if (link.href === "/search") return false;
    const isHome = link.href === "/";
    const pageKey = isHome ? "home" : link.href.split("/").filter(Boolean)[0];
    const pageConfig = (PAGES as any)[pageKey];
    return link.isActive !== false && pageConfig?.active !== false;
});
---

<header class="navbar">
    <ul class="nav-links">
        {
            links.map((link) => {
                const isActive =
                    currentPath === link.href ||
                    (link.href !== "/" && currentPath.startsWith(link.href));
                return (
                    <li>
                        <a href={link.href} class={`nav-link ${isActive ? "active" : "inactive"}`}>
                            {t(`nav.${KEY[link.href] ?? "about"}`)}
                        </a>
                    </li>
                );
            })
        }
    </ul>

    <div class="nav-actions">
        <a class="nav-icon" href="/archives" aria-label={t("nav.archives")} title={t("nav.archives")}>
            <Icon name="Archive" size={20} />
        </a>
        <a class="nav-icon" href="/search" aria-label={t("nav.search")} title={t("nav.search")}>
            <Icon name="Search" size={20} />
        </a>
    </div>
</header>

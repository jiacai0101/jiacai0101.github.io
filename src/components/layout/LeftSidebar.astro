---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";
import { getProfile } from "../../data/profile";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const appointment = profile.role.split(" · ")[0];
const activeSocials = SOCIALS.filter((s) => s.isActive);
const bioEntry = await getEntry("bio", lang === "zh" ? "bio-zh" : "bio");
const bio = bioEntry?.data;
const citations = profile.citations.toLocaleString("en-US");
---

<header class="masthead">
    <div class="masthead-identity">
        {
            bio?.avatar && (
                <Image
                    src={`/${bio.avatar}`}
                    alt={`Portrait of ${bio.name}`}
                    width={184}
                    height={184}
                    densities={[1.5, 2]}
                    format="webp"
                    class="masthead-avatar"
                    loading="eager"
                />
            )
        }
        <div class="masthead-copy">
            {bio?.name && <p class="masthead-name">{bio.name}</p>}
            <p class="masthead-role">{appointment}</p>
            {bio?.institution && <p class="masthead-info">{bio.institution}</p>}
            <ul class="masthead-meta">
                <li>
                    <a href={`mailto:${profile.email}`}>{profile.email}</a>
                </li>
                <li>
                    <a href={profile.scholarUrl} target="_blank" rel="noreferrer">
                        {t("sidebar.scholar")}
                    </a>
                    <span class="masthead-note"> · {citations} {t("sidebar.citations")}</span>
                </li>
                <li>
                    <a href={profile.cvUrl}>{t("sidebar.cv")}</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="masthead-socials">
        {
            activeSocials.map((social) => (
                <a
                    href={social.href}
                    aria-label={social.linkTitle}
                    title={social.linkTitle}
                    target="_blank"
                    rel="noreferrer"
                    class="social-link"
                >
                    <Icon
                        name={SOCIAL_ICONS[social.name] || social.name}
                        size={18}
                    />
                </a>
            ))
        }
    </div>
</header>

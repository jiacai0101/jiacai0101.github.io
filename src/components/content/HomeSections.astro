---
import { getProfile } from "../../data/profile";
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
    locale: Lang;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = getProfile(locale);
---

<section class="home-section">
    <h2 class="section-heading">{t("home.research")}</h2>
    <ul class="plain-list">
        {profile.research.map((area) => (
            <li class="plain-row">
                <span class="plain-name">{area.title}</span>
                <span class="plain-desc">{area.focus}</span>
            </li>
        ))}
    </ul>
</section>

<section class="home-section">
    <h2 class="section-heading">{t("home.platforms")}</h2>
    <ul class="plain-list">
        {profile.platforms.map((p) => (
            <li class="plain-row">
                {p.url ? (
                    <a class="plain-name" href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
                ) : (
                    <span class="plain-name">{p.name}</span>
                )}
                <span class="plain-desc">{p.description}</span>
            </li>
        ))}
    </ul>
</section>

---
import { getProfile } from "../../data/profile";
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
    locale: Lang;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = getProfile(locale);
const platformsCaption =
    locale === "zh"
        ? "10+ 开源平台 · 5.5M+ 访问 · 覆盖 100+ 国家 · 5 项软件著作权"
        : "10+ open-source platforms · 5.5M+ visits from 100+ countries · 5 software copyrights";
---

<section class="news-section">
    <h2 class="section-heading title-lg"><span class="section-emoji">🧬</span>{t("home.research")}</h2>
    <ul class="news-list">
        {profile.research.map((area) => (
            <li class="card">
                <div class="card-title-text title-md">{area.title}</div>
                <p class="body-sm body-muted">{area.focus}</p>
            </li>
        ))}
    </ul>
</section>

<section class="news-section">
    <h2 class="section-heading title-lg"><span class="section-emoji">🚀</span>{t("home.platforms")}</h2>
    <p class="section-caption body-sm body-muted">{platformsCaption}</p>
    <div class="platform-grid">
        {profile.platforms.map((p) => {
            const Tag = p.url ? "a" : "div";
            return (
                <Tag
                    class:list={["platform-card", { "platform-card-static": !p.url, "platform-has-qr": !!p.qr }]}
                    href={p.url || undefined}
                    target={p.url ? "_blank" : undefined}
                    rel={p.url ? "noopener noreferrer" : undefined}
                >
                    <img src={p.image} alt={p.name} class="platform-logo" loading="lazy" />
                    <div>
                        <div class="card-title-text title-md">{p.name}</div>
                        <p class="body-sm body-muted">{p.description}</p>
                    </div>
                    {p.qr && (
                        <span class="platform-qr-popover">
                            <img src={p.qr} alt={`${p.name} WeChat QR code`} width="160" height="160" loading="lazy" />
                            <span class="platform-qr-cap">Scan to follow on WeChat</span>
                        </span>
                    )}
                </Tag>
            );
        })}
    </div>
</section>

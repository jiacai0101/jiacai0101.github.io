---
import { NEWS } from "../../data/news";

interface Props {
    limit?: number;
}

const { limit } = Astro.props;
const items = [...NEWS]
    .sort((a, b) => b.sortDate.localeCompare(a.sortDate))
    .slice(0, limit ?? NEWS.length);
---

<ul class="news-feed">
    {
        items.map((item) => (
            <li class="news-feed-item">
                <span class="news-feed-marker">
                    <span class="news-feed-dot" />
                </span>
                <div class="news-feed-body">
                    <span class="news-feed-badge">{item.badge}</span>
                    {item.link ? (
                        <a
                            class="news-feed-title"
                            href={item.link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={item.description}
                        >
                            {item.title}
                            <span class="news-feed-arrow">↗</span>
                        </a>
                    ) : (
                        <span class="news-feed-title" title={item.description}>
                            {item.title}
                        </span>
                    )}
                </div>
                <time class="news-feed-date mono">{item.date}</time>
            </li>
        ))
    }
</ul>

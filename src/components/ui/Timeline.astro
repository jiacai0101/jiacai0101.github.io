---
export interface TimelineItemData {
    title: string;
    period: string;
    subtitle: string;
    description?: string;
    thesis?: string;
    logo?: string;
}

interface Props {
    items: TimelineItemData[];
}

const { items } = Astro.props;
---

<ol class="cv-list">
    {
        items.map((item) => (
            <li class="cv-row">
                <span class="cv-period">{item.period}</span>
                <div class="cv-entry">
                    <p class="cv-role">{item.title}</p>
                    <p class="cv-place">{item.subtitle}</p>
                    {item.description && <p class="cv-desc">{item.description}</p>}
                    {item.thesis && <p class="cv-desc">Thesis: {item.thesis}</p>}
                </div>
            </li>
        ))
    }
</ol>

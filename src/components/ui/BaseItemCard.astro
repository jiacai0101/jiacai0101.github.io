---
import Tag from "./Tag.astro";
import Icon from "./Icon.astro";
import { SITE } from "../../config";

interface Props {
    title: string;
    href: string;
    description?: string;
    date?: string;
    authors?: string;
    extraInput?: string;
    tags?: string[];
    externalUrl?: string;
    authorRole?: string;
    impactFactor?: number;
    quartile?: string;
    highlight?: string;
}

const { title, href, description, date, authors, extraInput, tags, externalUrl, authorRole, impactFactor, quartile, highlight } = Astro.props;

// Split the author string so the site owner's name can be bolded.
const authorParts = authors ? authors.split(new RegExp(`(${SITE.author})`, "g")) : [];
const impactLabel = impactFactor
    ? `IF ${impactFactor}${quartile ? ` · ${quartile}` : ""}`
    : quartile;
---

<article class="card">
    <div class="card-content">
        <a href={href} class="card-title">{title}</a>

        <div class="card-meta">
            {date && (
                <span class="flex items-center gap-1">
                    <Icon name="Calendar" size={24} />
                    <span>{date}</span>
                </span>
            )}
            {authors && (
                <span class="flex items-center gap-1">
                    <Icon name="User" size={24} />
                    <span>
                        {authorParts.map((part) =>
                            part === SITE.author ? <strong>{part}</strong> : part,
                        )}
                    </span>
                </span>
            )}
            {extraInput && (
                <span class="flex items-center gap-1">
                    <Icon name="Institution" size={24} />
                    <span>{extraInput}</span>
                </span>
            )}
        </div>

        {
            (authorRole || impactLabel || highlight) && (
                <div class="pub-badges">
                    {authorRole && <span class="pub-badge pub-badge-role">{authorRole}</span>}
                    {impactLabel && <span class="pub-badge">{impactLabel}</span>}
                    {highlight && <span class="pub-badge pub-badge-cite">{highlight}</span>}
                </div>
            )
        }

        {
            tags && tags.length > 0 && (
                <div class="flex gap-2 flex-wrap mb-3">
                    {tags.map((tag) => (
                        <Tag name={tag} size="sm" />
                    ))}
                </div>
            )
        }

        {description && <p class="card-desc">{description}</p>}
    </div>

    {
        externalUrl && (
            <div class="flex-shrink-0">
                <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="card-link">
                    View
                </a>
            </div>
        )
    }
</article>
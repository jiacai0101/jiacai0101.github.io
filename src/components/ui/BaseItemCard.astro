---
import { SITE } from "../../config";

interface Props {
    title: string;
    href: string;
    description?: string;
    date?: string;
    authors?: string;
    extraInput?: string;
    tags?: string[];
    externalUrl?: string;
    authorRole?: string;
    impactFactor?: number;
    quartile?: string;
    highlight?: string;
}

const { title, href, description, date, authors, extraInput, externalUrl } = Astro.props;

const authorParts = authors ? authors.split(new RegExp(`(${SITE.author})`, "g")) : [];
---

<article class="card">
    <div class="card-content">
        <a href={href} class="card-title">{title}</a>
        <div class="card-meta">
            {date && <span>{date}</span>}
            {extraInput && <span>{extraInput}</span>}
        </div>
        {authors && (
            <p class="card-authors">
                {authorParts.map((part) =>
                    part === SITE.author ? <strong>{part}</strong> : part,
                )}
            </p>
        )}
        {description && <p class="card-desc">{description}</p>}
    </div>
    {externalUrl && (
        <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="bib-link">
            Link
        </a>
    )}
</article>

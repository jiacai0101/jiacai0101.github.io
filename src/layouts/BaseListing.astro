---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BaseItemCard from "../components/ui/BaseItemCard.astro";
import BibliographyList from "../components/content/BibliographyList.astro";
import { getListingItem } from "../utils/adapters";
import { localizePath, stripLocaleId, useTranslations, type Lang } from "../i18n/ui";

interface Props {
    collection: "publications" | "talks" | "projects" | "posts" | "teaching" | "all";
    title: string;
    subtitle?: string;
    entries?: any[];
    page?: any;
    locale?: Lang;
}

const { collection, title, subtitle, entries: manualEntries, page, locale = "en" } = Astro.props;
const t = useTranslations(locale);

const isZhId = (id: string) => id.startsWith("zh/");
let entries = manualEntries || (collection !== "all" ? await getCollection(collection as any) : []);
if (page) entries = page.data;
entries = entries.filter((e: any) => (locale === "zh" ? isZhId(e.id) : !isZhId(e.id)));

const sortedEntries = [...entries].sort((a: any, b: any) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});
---

<BaseLayout title={title}>
    {(title || subtitle) && (
        <header class="page-header">
            {title && <h1 class="page-title">{title}</h1>}
            {subtitle && <p class="page-subtitle">{subtitle}</p>}
        </header>
    )}

    {collection === "publications" ? (
        <BibliographyList entries={sortedEntries} locale={locale} groupByYear />
    ) : (
        <section class="item-list">
            {sortedEntries.map((entry: any) => {
                const item = getListingItem(entry);
                const slug = stripLocaleId(entry.id);
                return <BaseItemCard {...item} href={localizePath(`/${collection}/${slug}`, locale)} />;
            })}
        </section>
    )}

    {page && page.lastPage > 1 && (
        <nav class="pagination" aria-label="Pagination">
            {page.url.prev ? (
                <a href={page.url.prev} class="pagination-link">&larr; {t("list.prev")}</a>
            ) : (
                <span class="pagination-inactive">&larr; {t("list.prev")}</span>
            )}
            <span class="pagination-info">{page.currentPage} / {page.lastPage}</span>
            {page.url.next ? (
                <a href={page.url.next} class="pagination-link">{t("list.next")} &rarr;</a>
            ) : (
                <span class="pagination-inactive">{t("list.next")}</span>
            )}
        </nav>
    )}
</BaseLayout>
